NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local
# Server-only. Must match the API's API_PROXY_SHARED_SECRET so the API can
# rate-limit by the real client IP when calls go through the /api/v1 proxy.
API_PROXY_SHARED_SECRET=
# Sentry error reporting. Off unless a DSN is set. NEXT_PUBLIC_SENTRY_DSN is
# built into the browser bundle; SENTRY_DSN is used on the server.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# The Content Security Policy is report-only until CSP_ENFORCE=true (needs a
# rebuild). CSP_REPORT_URI can be Sentry's security endpoint for the project.
CSP_ENFORCE=false
CSP_REPORT_URI=
# Public catalog media host (the storage proxy). Required in production;
# there is no built-in fallback host.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=
# Hosts the storage proxy may redirect image requests to (comma separated).
STORAGE_REDIRECT_HOSTS=storage.railway.app
