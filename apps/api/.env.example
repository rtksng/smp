NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/surgical_platform?schema=public
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_PREFIX=surgical-platform
DELIVERY_SUPPORT_PHONE=+911145678900
DELIVERY_SUPPORT_EMAIL=delivery-operations@example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
TRUST_PROXY=false
# Shared with the web and admin apps so the API can trust the client IP their
# proxies forward. Use a long random value (32+ characters) in production.
API_PROXY_SHARED_SECRET=
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000
ERROR_MONITORING_ENABLED=false
# Sentry DSN. Reporting turns on in production once this is set.
ERROR_MONITORING_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_SALT_ROUNDS=12
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_EXPOSE_IN_RESPONSE=false
# Demo numbers (app-store review, internal testing). With OTP_DEMO_CODE set they
# log in with that fixed 6-digit code, which is never returned or sent.
# Production requires OTP_DEMO_CODE whenever demo numbers are set.
OTP_DEMO_CUSTOMER_MOBILE_NUMBERS=+919000000000
OTP_DEMO_DELIVERY_MOBILE_NUMBERS=
OTP_DEMO_CODE=
SWAGGER_ENABLED=true
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage/uploads
STORAGE_PUBLIC_PATH=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
STORAGE_IMAGE_MAX_BYTES=5242880
STORAGE_DOCUMENT_MAX_BYTES=10485760
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
# Online orders still unpaid after this many minutes are cancelled every
# 5 minutes, after checking Razorpay, and their stock and coupon use released.
UNPAID_ORDER_EXPIRY_ENABLED=true
UNPAID_ORDER_TIMEOUT_MINUTES=30
RAZORPAY_REQUEST_TIMEOUT_MS=10000
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket for customer and delivery partner documents, proofs and incident
# photos. Use a bucket with no public access (not behind the public media
# proxy). If unset they go to S3_BUCKET under private/.
S3_PRIVATE_BUCKET=
# Credentials for S3_PRIVATE_BUCKET when it has its own (Railway gives each
# bucket its own keys). Any left empty fall back to the S3_* values above.
S3_PRIVATE_ENDPOINT=
S3_PRIVATE_REGION=
S3_PRIVATE_ACCESS_KEY_ID=
S3_PRIVATE_SECRET_ACCESS_KEY=
# Public URL of this API, used in signed links to private files. On Railway
# RAILWAY_PUBLIC_DOMAIN is used when this is unset.
API_PUBLIC_URL=
