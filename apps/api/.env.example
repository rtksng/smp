JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_SALT_ROUNDS=12
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
OTP_EXPOSE_IN_RESPONSE=false
OTP_DEMO_CUSTOMER_MOBILE_NUMBERS=+919000000000
