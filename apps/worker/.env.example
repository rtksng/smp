NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/surgical_platform?schema=public
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_PREFIX=surgical-platform
RAZORPAY_WEBHOOK_SECRET=
WORKER_PREFLIGHT_ON_STARTUP=true
WORKER_PREFLIGHT_TIMEOUT_MS=5000
ERROR_MONITORING_ENABLED=false
# Sentry DSN. Reporting turns on in production once this is set.
ERROR_MONITORING_DSN=

# Customer emails via Resend (worker). Nothing is sent unless enabled; see
# apps/worker/src/email/README.md. Keep RESEND_API_KEY in a secret store.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
# Example: "Surgical Medical Equipment <orders@mail.your-domain.in>"
EMAIL_FROM=
EMAIL_SUPPORT_ADDRESS=
EMAIL_REPLY_TO=
# HTTPS origin of the customer website, used for links in emails.
CUSTOMER_SITE_URL=
EMAIL_BRAND_NAME=

# Login codes via WhatsApp Cloud API (worker). Nothing is sent unless enabled.
# Keep WHATSAPP_ACCESS_TOKEN in Railway variables, never in the repo. Use a
# permanent System User token, not the 24-hour token from the API setup page.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
# Numeric "Phone number ID" from WhatsApp > API Setup, not the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version shown in your Meta app, for example v23.0.
WHATSAPP_GRAPH_API_VERSION=
# Name and language of your approved authentication template.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# Keep equal to the API's OTP_TTL_SECONDS; expired codes are not sent.
OTP_TTL_SECONDS=300
