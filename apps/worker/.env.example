NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/surgical_platform?schema=public
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_PREFIX=surgical-platform
RAZORPAY_WEBHOOK_SECRET=
WORKER_PREFLIGHT_ON_STARTUP=true
WORKER_PREFLIGHT_TIMEOUT_MS=5000
ERROR_MONITORING_ENABLED=false
ERROR_MONITORING_DSN=

# Customer emails via Resend (worker). Nothing is sent unless enabled; see
# apps/worker/src/email/README.md. Keep RESEND_API_KEY in a secret store.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
# Example: "Surgical Medical Equipment <orders@mail.your-domain.in>"
EMAIL_FROM=
EMAIL_SUPPORT_ADDRESS=
EMAIL_REPLY_TO=
# HTTPS origin of the customer website, used for links in emails.
CUSTOMER_SITE_URL=
EMAIL_BRAND_NAME=
