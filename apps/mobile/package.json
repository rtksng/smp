{
  "name": "@surgical/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "dev": "expo start",
    "ios": "expo run:ios",
    "lint": "eslint app components lib",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/dom-webview": "~56.0.6",
    "@expo/metro-runtime": "~56.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.100.14",
    "expo": "~56.0.17",
    "expo-constants": "~56.0.22",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.16",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.85.3",
    "@testing-library/react": "16.3.2",
    "babel-preset-expo": "^56.0.15",
    "jsdom": "29.1.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    }
  }
}
